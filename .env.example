# Mapbox Configuration
# Get your token at: https://account.mapbox.com/access-tokens/
# Free tier includes 50,000 map loads per month
VITE_MAPBOX_TOKEN=pk.your_mapbox_token_here

# Make.com Webhook Configuration (Optional)
# Set up a webhook scenario at: https://www.make.com/
# This is only needed if you want to use the "Send to Make.com" feature
VITE_MAKE_WEBHOOK_URL=

# Supabase Configuration
# These are pre-configured for this project
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
